# Non-secret defaults for the Base44 local dev environment.
# Loaded FIRST, so any real credential the user supplies (delivered to
# /run/base44/app.env) always overrides these placeholders.
#
# These are names/URLs only — no credentials here. Real secrets (Azure OpenAI
# keys, Azure AI Search keys, MiniMax key, endpoints) come from /run/base44/app.env.

# Model deployment names (see .env.example)
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5-mini"
AZURE_AI_SMALL_MODEL="gpt-5-nano"
AZURE_AI_LARGE_MODEL="gpt-5-mini"
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-5-mini"

# MiniMax (OpenAI-compatible alternative provider) — key comes from app.env
MINIMAX_BASE_URL="https://api.minimax.io/v1"
MINIMAX_MODEL_ID="MiniMax-M3"
